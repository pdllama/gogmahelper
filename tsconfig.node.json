{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,

    "paths": {
      "@data/*": ["./data/*"],
      "@components/*": ["./src/components/*"],
      "@custom_types/*": ["./src/types/*"],
      "@app/*": ["./src/app/*"],
      "@file/*": ["./file/*"],
      "@file_readers/*": ["./file/filereaders/*"],
      "@file_writers/*": ["./file/filewriters/*"]
    }
  },
  "include": ["vite.config.ts"]
}
